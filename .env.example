# ---------------------------------------------------------------------------
# FinPilot — environment template. Copy to `.env` locally. Never commit `.env`.
# All values below are placeholders; replace with your own keys ONLY in `.env`.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=FinPilot
APP_ENV=development
SERVICE_NAME=finpilot-api
LOG_LEVEL=INFO

# --- CORS (comma-separated, no wildcard in production) ---
CORS_ORIGINS=http://localhost:3000

# --- LLM (Phase 3 stores config only; not wired until later phase) ---
LLM_PROVIDER=xai            # xai | ollama
XAI_API_KEY=                # server-only (Grok). Never expose to the browser.
XAI_MODEL=grok-4.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Supabase (Phase 3: schema + seed + database health via FastAPI) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECURITY: service-role key is SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_,
# never commit, never log, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data ---
DEMO_DATA_PATH=data/demo_data.csv
DB_TIMEOUT_SECONDS=5